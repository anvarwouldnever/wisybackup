{
  "expo": {
    "scheme": "mywisy",
    "name": "MyWisy",
    "slug": "wisy",
    "version": "1.0.0",
    "icon": "./assets/wisyIcon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "ios": {
      "config": {
        "usesNonExemptEncryption": false
      },
      "requireFullScreen": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.avtechsoftware.mywisy",
      "associatedDomains": [
        "applinks:mywisy.com"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "mailto",
          "message",
          "readdle-spark",
          "airmail",
          "ms-outlook",
          "googlegmail",
          "inbox-gmail",
          "ymail",
          "superhuman",
          "yandexmail",
          "fastmail",
          "protonmail"
        ],
        "CFBundleShortVersionString": "1.0.0",
        "CFBundleVersion": "9",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow MyWisy to access your camera to take photos or record videos.",
        "NSMicrophoneUsageDescription": "Allow MyWisy to access your microphone while recording videos.",
        "NSPhotoLibraryUsageDescription": "Allow MyWisy to access your photo library to upload or save media.",
        "NSLocationWhenInUseUsageDescription": "Allow MyWisy to access your location data when capturing media to attach location information.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow MyWisy to access your microphone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ACA5F6",
          "image": "./assets/ebloWisy.png",
          "dark": {
            "image": "./assets/ebloWisy.png",
            "backgroundColor": "#ACA5F6"
          },
          "imageWidth": 200
        }
      ],
      [
        "react-native-email-link"
      ],
      "expo-secure-store"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anvarwouldnever3.wisy",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "11386f1b-6825-43f7-a2d1-4cdea0c20043"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/11386f1b-6825-43f7-a2d1-4cdea0c20043"
    }
  }
}
